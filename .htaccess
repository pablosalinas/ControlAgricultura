<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /agricultura/

    # Si es un archivo o directorio físico real (CSS, JS, imágenes, install.php), servirlo directo
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # De lo contrario, redirigir al punto de entrada index.php con la ruta
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# En caso de que mod_rewrite esté inactivo, gestionar errores 404 enviando a index.php
ErrorDocument 404 /agricultura/index.php
