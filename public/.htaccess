<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si el archivo o carpeta existe físicamente, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # De lo contrario, redirigir al enrutador principal index.php
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>
