# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - AGRODIETARIO
# Copiar este archivo a .env y ajustar según corresponda (local o producción)
# ==============================================================================

APP_NAME="AgroDietario"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/agrodietario/public

# BASE DE DATOS (Por defecto configurada para XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agrodietario_db
DB_USER=root
DB_PASS=

# CAPTCHA (Opciones: local_gd, turnstile, recaptcha)
CAPTCHA_DRIVER=local_gd
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# SUBIDAS DE ARCHIVOS
UPLOAD_MAX_MB=10
